# Copy to .env and fill in. Only ONE provider block is needed.
# Default provider is `nemotron` (see shadow/config.py).

# --- provider: nemotron (NVIDIA Nemotron 3 Super 120B on Bedrock) ---
# DEFAULT. Uses plain AWS keys via boto3 Converse.
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# Nemotron is NOT served in ap-south-1 (Mumbai) and has no global routing.
# Supported: us-east-1, us-east-2, us-west-2, eu-south-1, eu-west-1,
#            eu-west-2, ap-northeast-1, ap-southeast-2, ap-southeast-4,
#            sa-east-1, us-gov-west-1
# Set an unsupported value and config.py redirects to ap-northeast-1 (Tokyo).
AWS_REGION=ap-northeast-1

# --- provider: bedrock (Claude via AWS) ---
# Same AWS keys as above. Needs: pip install -e ".[claude]"
# SHADOW_PROVIDER=bedrock
# SHADOW_MODEL=anthropic.claude-sonnet-5

# --- provider: anthropic (Claude direct) ---
# SHADOW_PROVIDER=anthropic
# SHADOW_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- provider: foundry (Claude via Microsoft) ---
# SHADOW_PROVIDER=foundry
# SHADOW_MODEL=claude-sonnet-5
# FOUNDRY_ENDPOINT=https://your-resource.services.ai.azure.com
# FOUNDRY_API_KEY=...

# --- optional overrides ---
# SHADOW_TEMPERATURE=0.9        # nemotron only; Claude 400s on this
# SHADOW_EFFORT=low             # Claude paths only
# SHADOW_AWS_REGION=            # force a region without touching AWS_REGION
# SHADOW_CDP_URL=http://localhost:9222
