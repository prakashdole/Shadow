# Copy to .env and fill in the values you use.
# Gemini keys for Decision 1, chat transcription and the reply fallback.
# Backup keys are used only when a key is rejected, not to get around a quota.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=

# OpenAI key for the screenshot draft. SHADOW_OPENAI_API_KEY still wins when set.
# OPENAI_API_KEY=

# --- provider: anthropic (Claude direct) ---
# SHADOW_PROVIDER=anthropic
# SHADOW_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- optional overrides ---
# SHADOW_EFFORT=low             # Claude paths only
# SHADOW_CDP_URL=http://localhost:9222

# NVIDIA API key
NVIDIA_API_KEY=
